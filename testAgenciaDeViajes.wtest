import agenciaDeViajes.*

describe "Tests de sugeridos" {
  //Tests 1

  test "Un pack nacional sin beneficios vigentes devuelve el mismo precio base." {
    const beneficio1 = new Beneficio(tipo = "Acceso a salas VIP", costo = 20000)
    const packNacionalFio = new PackNacional(duracion = 2, precioBase = 60000, beneficiosEspeciales = [beneficio1], coordinador = "Julio", destinoProvincia = "Santa Fe")
    assert.equals(60000, packNacionalFio.precioTotal())
  }

  test "Un pack nacional con 2 beneficios vigentes suma correctamente sus costos al precio base." {
    const beneficio1 = new Beneficio(tipo = "Acceso a salas VIP", costo = 20000, estaVigente = true)
    const beneficio2 = new Beneficio(tipo = "Acceso a salas VIP", costo = 25000, estaVigente = true)
    const packNacionalRed = new PackNacional(duracion = 2, precioBase = 60000, beneficiosEspeciales = [beneficio1, beneficio2], coordinador = "Gustav", destinoProvincia = "Buenos Aires")
    
    assert.equals(105000, packNacionalRed.precioTotal())
  }

  test "Un pack internacional sin beneficios vigentes calcula correctamente el total con el 20% de recargo." {
    const beneficio1 = new Beneficio(tipo = "Acceso a salas VIP", costo = 20000)
    const beneficio2 = new Beneficio(tipo = "Acceso a salas VIP", costo = 25000)
    const packInternacionalSapphire = new PackInternacional(duracion = 2, precioBase = 60000, beneficiosEspeciales = [beneficio1, beneficio2])

    assert.equals(72000, packInternacionalSapphire.precioTotal())
  }

  //Tests 2

  test "Un guía motivado con 21 viajes realizados es considerado altamente calificado." {
    const coordinadorJuan = new Coordinador(cantidadDeViajes = 21, estaMotivado = true)
  
    assert.that(coordinadorJuan.altamenteCalificado())
  }

  test "Un asistente logístico con menos de 3 años de experiencia no es calificado, aunque tenga muchos viajes." {
    const coordinadorLeo = new Coordinador(cantidadDeViajes = 21, estaMotivado = true, anios = 2, rol = "Asistente logistico")
    
    assert.notThat(coordinadorLeo.altamenteCalificado())
  }

  test "Un acompañante con cualquier cantidad de viajes es siempre calificado si supera los 20." {
    const coordinadorGustav = new Coordinador(cantidadDeViajes = 21, rol = "Acompaniante")
    
    assert.that(coordinadorGustav.altamenteCalificado())
  }

  //Tests 3

  test "Pack Nacional es Premium" {
    const coordinadorGustav = new Coordinador(cantidadDeViajes = 21, rol = "Acompaniante")
    const packNacionalRed = new PackNacional(duracion = 12, precioBase = 60000, coordinador = coordinadorGustav, destinoProvincia = "Buenos Aires")
    
    assert.that(packNacionalRed.esPremium())
  }

  test "Pack Internacional no es Premium" {
    const packInternacionalSapphire = new PackInternacional()

    assert.notThat(packInternacionalSapphire.esPremium())
  }

  //Tests 4

  test "packProvincial no esPremium y precioTotal no recibe el 5%" {
    const packProvincialNeo = new PackProvincial(precioBase = 20000)

    assert.notThat(packProvincialNeo.esPremium())
    assert.equals(20000, packProvincialNeo.precioTotal())
  }

  test "packProvincial si esPremium y precioTotal recibe el 5%" {
    const beneficio1 = new Beneficio(tipo = "Acceso a salas VIP", costo = 20000, estaVigente = true)
    const beneficio2 = new Beneficio(tipo = "Acceso a salas VIP", costo = 25000, estaVigente = true)
    const beneficio3 = new Beneficio(tipo = "Acceso a salas VIP", costo = 20000, estaVigente = true)
    const beneficio4 = new Beneficio(tipo = "Acceso a salas VIP", costo = 25000, estaVigente = true)
    const packProvincialNeo = new PackProvincial(precioBase = 30000, listaActividades = ["ac", "as", "fg", "ra"], cantidadDeCiudades = 6, beneficiosEspeciales = [beneficio1, beneficio2, beneficio3, beneficio4])

    assert.that(packProvincialNeo.esPremium())
    assert.equals(180000, packProvincialNeo.precioTotal())
  }
}